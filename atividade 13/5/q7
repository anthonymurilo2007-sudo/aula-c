#include <stdio.h>
 
int main() {
    int numeros[8];
    int i;
 
    
    for(i = 0; i < 8; i++) {
        printf("Digite um numero: ");
        scanf("%d", &numeros[i]);
    }
 
    
    printf("\nOrdem inversa:\n");
 
    for(i = 7; i >= 0; i--) {
        printf("%d ", numeros[i]);
    }
 
    return 0;
}